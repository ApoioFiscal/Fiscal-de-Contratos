# Parsing — PDF → dados estruturados
#
# Copie este arquivo para `.env` e preencha com os valores corretos.
# O `.env` NÃO deve ser versionado.

PORT=3000

# Conexão com o PostgreSQL (mesmo banco "prefeitura" usado pelo backend).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/prefeitura

# Modo de extração: "rules" (regras locais, sem dependências externas) ou "ollama".
# Recomendado: rules. Se ollama falhar, o sistema volta automaticamente para rules.
PARSER_MODE=rules

# Opcional — usado apenas quando PARSER_MODE=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma
# OLLAMA_TIMEOUT_MS=200000
# OLLAMA_KEEP_ALIVE=10m

# Contratante fixo: a própria prefeitura. Quando definido, vence o que o OCR ler no PDF
# (evita "MAR1ZOPOLIS", CNPJ com dígito trocado etc.). Se não definir, usa o padrão do código.
CONTRATANTE_NOME=Prefeitura Municipal de Marizópolis
CONTRATANTE_CNPJ=01.612.941/0001-49
# CONTRATANTE_ENDERECO=Rua João Vicente de Almeida, SN - Edilson Alves - Marizopolis - PB
