# Frontend — Fiscal de Contratos
#
# Copie este arquivo para `.env` localmente OU defina as mesmas variáveis
# no painel da Vercel (Settings -> Environment Variables) — cada uma com
# prefixo VITE_ para ser embutida no build.

# (Opcional) URL base da API do backend. Padrão: "/api" (proxy do Vite em dev).
# Em produção, aponte para o serviço do Render:
#   https://apoiofiscal-backend.onrender.com/api
VITE_API_URL=/api

# (Opcional) URL base do serviço de parsing de PDF. Padrão: http://localhost:3000
# Em produção, aponte para o serviço do Render:
#   https://apoiofiscal-parsing.onrender.com
VITE_PARSING_URL=http://localhost:3000