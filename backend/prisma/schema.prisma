generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Setor {
  id                         Int              @id @default(autoincrement())
  nome                       String
  sigla                      String           @unique
  tipo                       TipoSetor        @default(SECRETARIA)
  responsavel                String?
  descricao                  String?
  idSetor                    Int?
  criadoEm                   DateTime         @default(now())
  atualizadoEm               DateTime         @updatedAt
  setorPai                   Setor?           @relation("SetorHierarquia", fields: [idSetor], references: [id])
  subSetores                 Setor[]          @relation("SetorHierarquia")
  contratos                  ContratoSetor[]
  pedidosSolicitados         Pedido[]         @relation("SolicitantePedido")
  termosRenovacaoSolicitados TermoRenovacao[] @relation("SolicitanteTermo")
  usuarios                   Usuario[]

  @@map("setor")
}

model Usuario {
  id               Int               @id @default(autoincrement())
  idSetor          Int
  nome             String
  email            String            @unique
  senha            String
  funcao           FuncaoUsuario
  isAdmin          Boolean           @default(false)
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt
  avaliacoesFeitas Avaliacao[]
  pedidosCriados   Pedido[]
  historicoPedidos PedidoHistorico[]
  termosEmitidos   TermoRenovacao[]  @relation("TermoEmissor")
  termosResolvidos TermoRenovacao[]  @relation("TermoResolvido")
  setor            Setor             @relation(fields: [idSetor], references: [id])

  @@index([idSetor])
  @@map("usuario")
}

// Contrato administrativo. Os campos vêm da extração real do PDF assinado
// (`ContratoExtraction` no pacote `parsing`, validado por `contrato.schema.ts`).
// Nada de `dataAbertura`, `fornecedor` ou `cnpjFornecedor`: abertura é da licitação,
// e a empresa é o `contratado`.
model Contrato {
  id                   Int            @id @default(autoincrement())
  numero               String         @unique
  numeroProcesso       String?
  modalidade           String?
  numeroModalidade     String?
  objeto               String?
  valorTotal           Float?
  // Vigência: `fim` pode ter sido calculada a partir de uma duração (ex.: "12 meses").
  vigenciaInicio       DateTime?
  vigenciaFim          DateTime?
  vigenciaFimCalculada Boolean        @default(false)
  vigenciaTrecho       String?
  foro                 String?
  status               StatusContrato @default(RASCUNHO)

  // Assinatura
  assinaturaLocal      String?
  assinaturaData       DateTime?
  assinaturaDigital    Boolean   @default(false)
  assinaturaPlataforma String?
  assinaturaAssinante  String?

  fundamentacaoLegal         String[]
  condicoes                  Json?
  avisos                     String[]
  itensConferemTotalTabela   Boolean?
  itensConferemValorContrato Boolean?

  // PDF assinado importado — a fonte do contrato.
  arquivoPdf     String?
  arquivoPdfNome String?
  // Payload completo devolvido pelo parsing, preservado como veio (auditoria).
  dadosExtraidos Json?
  importadoEm    DateTime  @default(now())
  extraidoEm     DateTime?
  atualizadoEm   DateTime  @updatedAt

  partes          ContratoParte[]
  signatarios     ContratoSignatario[]
  itens           ContratoItem[]
  dotacoes        ContratoDotacao[]
  setores         ContratoSetor[]
  pedidos         Pedido[]
  notasFiscais    NotaFiscal[]
  avaliacoes      Avaliacao[]
  termosRenovacao TermoRenovacao[]

  @@map("contrato")
}

// Contratante e contratado. O representante é a qualificação da pessoa física que
// assina pela parte (cargo, CPF, RG, nacionalidade, estado civil, profissão).
model ContratoParte {
  id                          Int            @id @default(autoincrement())
  idContrato                  Int
  papel                       PapelParte     @default(CONTRATADO)
  nome                        String?
  documento                   String?
  tipoDocumento               TipoDocumento? @map("tipo_documento")
  endereco                    String?
  representanteNome           String?
  representanteCargo          String?
  representanteCpf            String?
  representanteRg             String?
  representanteOrgaoEmissorRg String?
  representanteNacionalidade  String?
  representanteEstadoCivil    String?
  representanteProfissao      String?
  representanteEndereco       String?
  contrato                    Contrato       @relation(fields: [idContrato], references: [id])

  @@unique([idContrato, papel])
  @@index([idContrato])
  @@map("contrato_parte")
}

// Quem assinou o PDF. `confirmadoNoBloco` = o nome foi confirmado no bloco de
// assinatura (e não só na qualificação das partes); `legivel` = o OCR conseguiu ler.
model ContratoSignatario {
  id                Int             @id @default(autoincrement())
  idContrato        Int
  papel             PapelSignatario
  ordem             Int             @default(0)
  nome              String?
  cargo             String?
  cpf               String?
  cnpj              String?
  rg                String?
  orgaoEmissorRg    String?
  nacionalidade     String?
  estadoCivil       String?
  profissao         String?
  endereco          String?
  confirmadoNoBloco Boolean         @default(false)
  legivel           Boolean         @default(true)
  contrato          Contrato        @relation(fields: [idContrato], references: [id])

  @@index([idContrato])
  @@map("contrato_signatario")
}

// Item do contrato. `recebido`/`consumido` são operacionais (estoque/pedidos) e não
// vêm do PDF. `quantidade` é Float porque o contrato real tem m²/kg fracionários.
model ContratoItem {
  id              Int                   @id @default(autoincrement())
  idContrato      Int
  codigo          Int?
  descricao       String
  unidade         String
  unidadeOriginal String?
  quantidade      Float
  valorUnitario   Float
  valorTotal      Float
  correcoes       String[]
  recebido        Float                 @default(0)
  consumido       Float                 @default(0)
  contrato        Contrato              @relation(fields: [idContrato], references: [id])
  movimentacoes   MovimentacaoEstoque[]
  notaFiscalItems NotaFiscalItem[]
  pedidoItems     PedidoItem[]

  @@index([idContrato])
  @@map("contrato_item")
}

// Dotação orçamentária de uma unidade beneficiária (GABINETE, EDUCAÇÃO, SAÚDE...).
// É a fonte real do vínculo contrato ↔ secretaria.
model ContratoDotacao {
  id                    Int      @id @default(autoincrement())
  idContrato            Int
  unidadeCodigo         String
  unidade               String
  funcionalProgramatica String?
  acao                  String?
  ficha                 String?
  elementoCodigo        String?
  elementoDescricao     String?
  naturezaCodigo        String?
  natureza              String?
  complemento           String?
  contrato              Contrato @relation(fields: [idContrato], references: [id])

  @@index([idContrato])
  @@map("contrato_dotacao")
}

model ContratoSetor {
  id         Int           @id @default(autoincrement())
  idContrato Int
  idSetor    Int
  origem     OrigemVinculo @default(MANUAL)
  contrato   Contrato      @relation(fields: [idContrato], references: [id])
  setor      Setor         @relation(fields: [idSetor], references: [id])

  @@unique([idContrato, idSetor])
  @@index([idSetor])
  @@map("contrato_setor")
}

model Pedido {
  id                  Int                   @id @default(autoincrement())
  idUsuarioCriador    Int
  idSetorCriador      Int
  idContrato          Int
  numeroPedido        String                @unique
  dataPedido          DateTime              @default(now())
  dataPrevistaEntrega DateTime?
  status              StatusPedido          @default(PENDENTE)
  numeroOrdem         String?
  dataOrdem           DateTime?
  observacao          String?
  arquivoTermo        String?
  dataGeracaoTermo    DateTime?
  avaliacoes          Avaliacao[]
  movimentacoes       MovimentacaoEstoque[]
  notasFiscais        NotaFiscal[]
  contrato            Contrato              @relation(fields: [idContrato], references: [id])
  setor               Setor                 @relation("SolicitantePedido", fields: [idSetorCriador], references: [id])
  usuario             Usuario               @relation(fields: [idUsuarioCriador], references: [id])
  historico           PedidoHistorico[]
  itens               PedidoItem[]

  @@index([idSetorCriador])
  @@index([idContrato])
  @@map("pedido")
}

model PedidoHistorico {
  id        Int                 @id @default(autoincrement())
  idPedido  Int
  tipo      TipoHistoricoPedido
  status    StatusPedido?
  mensagem  String?
  idUsuario Int
  data      DateTime            @default(now())
  pedido    Pedido              @relation(fields: [idPedido], references: [id])
  usuario   Usuario             @relation(fields: [idUsuario], references: [id])

  @@index([idPedido])
  @@map("pedido_historico")
}

model PedidoItem {
  id             Int          @id @default(autoincrement())
  idPedido       Int
  idContratoItem Int
  quantidade     Float
  valorUnitario  Float
  valorTotal     Float
  itemContrato   ContratoItem @relation(fields: [idContratoItem], references: [id])
  pedido         Pedido       @relation(fields: [idPedido], references: [id])

  @@index([idPedido])
  @@index([idContratoItem])
  @@map("pedido_item")
}

model NotaFiscal {
  id            Int                   @id @default(autoincrement())
  idPedido      Int
  idContrato    Int
  numeroNota    String
  dataEmissao   DateTime
  dataEntrada   DateTime              @default(now())
  observacao    String?
  movimentacoes MovimentacaoEstoque[]
  contrato      Contrato              @relation(fields: [idContrato], references: [id])
  pedido        Pedido                @relation(fields: [idPedido], references: [id])
  itens         NotaFiscalItem[]

  @@index([idPedido])
  @@map("nota_fiscal")
}

model NotaFiscalItem {
  id             Int          @id @default(autoincrement())
  idNotaFiscal   Int
  idContratoItem Int
  quantidade     Float
  valorUnitario  Float
  // Conferência do fiscal de contratos no ato do recebimento
  marcaConferida Boolean      @default(false)
  itemContrato   ContratoItem @relation(fields: [idContratoItem], references: [id])
  notaFiscal     NotaFiscal   @relation(fields: [idNotaFiscal], references: [id])

  @@index([idNotaFiscal])
  @@index([idContratoItem])
  @@map("nota_fiscal_item")
}

model MovimentacaoEstoque {
  id             Int              @id @default(autoincrement())
  tipo           TipoMovimentacao
  idContratoItem Int
  quantidade     Float
  idNotaFiscal   Int?
  idPedido       Int?
  data           DateTime         @default(now())
  observacao     String?
  itemContrato   ContratoItem     @relation(fields: [idContratoItem], references: [id])
  notaFiscal     NotaFiscal?      @relation(fields: [idNotaFiscal], references: [id])
  pedido         Pedido?          @relation(fields: [idPedido], references: [id])

  @@index([idContratoItem])
  @@index([idNotaFiscal])
  @@map("movimentacao_estoque")
}

model Avaliacao {
  id                Int      @id @default(autoincrement())
  idPedido          Int
  idContrato        Int
  idUsuarioFiscal   Int
  dataAvaliacao     DateTime @default(now())
  notaEntrega       Int
  notaPrazo         Int
  possuiProblema    Boolean  @default(false)
  descricaoProblema String?
  observacao        String?
  contrato          Contrato @relation(fields: [idContrato], references: [id])
  pedido            Pedido   @relation(fields: [idPedido], references: [id])
  usuarioFiscal     Usuario  @relation(fields: [idUsuarioFiscal], references: [id])

  @@index([idContrato])
  @@index([idPedido])
  @@map("avaliacao")
}

model TermoRenovacao {
  id                  Int                  @id @default(autoincrement())
  idContrato          Int
  idUsuarioEmissor    Int
  idSetorSolicitante  Int?
  tipo                TipoRenovacao
  status              StatusTermoRenovacao @default(EMITIDO)
  justificativa       String
  novaVigenciaFim     DateTime?
  percentualAcrescimo Float?
  parecerLicitacao    String?
  acaoTomada          AcaoTomada?
  idUsuarioLicitacao  Int?
  dataEmissao         DateTime             @default(now())
  dataResolucao       DateTime?
  contrato            Contrato             @relation(fields: [idContrato], references: [id])
  setorSolicitante    Setor?               @relation("SolicitanteTermo", fields: [idSetorSolicitante], references: [id])
  usuarioEmissor      Usuario              @relation("TermoEmissor", fields: [idUsuarioEmissor], references: [id])
  usuarioLicitacao    Usuario?             @relation("TermoResolvido", fields: [idUsuarioLicitacao], references: [id])

  @@index([idContrato])
  @@index([status])
  @@map("termo_renovacao")
}

// Tabela gravada pelo pacote `parsing` (mesmo banco). O backend não a usa.
model pdf_data {
  id                 Int       @id @default(autoincrement())
  original_name      String
  mime_type          String
  file_size          Int
  raw_text           String
  structured_data    Json
  extraction_summary String?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
}

enum FuncaoUsuario {
  PREFEITO
  SECRETARIO
  SERVIDOR
  FISCAL
}

// Natureza do setor: unidade de governo (secretaria), setor administrativo
// (licitações, compras, fiscalização) ou o gabinete do prefeito.
enum TipoSetor {
  GABINETE
  SETOR
  SECRETARIA
}

enum StatusContrato {
  RASCUNHO
  ATIVA
  EM_ADITAMENTO
  ENCERRADA
  VENCIDA
}

// Papel da parte no contrato.
enum PapelParte {
  CONTRATANTE
  CONTRATADO
}

enum PapelSignatario {
  CONTRATANTE
  CONTRATADO
  TESTEMUNHA
}

enum TipoDocumento {
  CNPJ
  CPF
}

// De onde saiu o vínculo contrato ↔ secretaria.
enum OrigemVinculo {
  DOTACAO
  MANUAL
}

enum StatusPedido {
  PENDENTE
  CONFIRMADO
  EFETUADO
  ENTREGUE
  CONCLUIDO
  DEVOLVIDO
  CANCELADO
}

enum TipoHistoricoPedido {
  CRIACAO
  STATUS
  AVISO
}

enum TipoRenovacao {
  VIGENCIA
  QUANTITATIVO
  FINANCEIRO
}

enum StatusTermoRenovacao {
  EMITIDO
  EM_ANALISE
  RESOLVIDO
  ARQUIVADO
}

enum AcaoTomada {
  ADITIVO_VIGENCIA
  ADITIVO_QUANTITATIVO
  ADITIVO_FINANCEIRO
  NOVA_LICITACAO
  DENEGADO
}

enum TipoMovimentacao {
  ENTRADA
  BAIXA
}
