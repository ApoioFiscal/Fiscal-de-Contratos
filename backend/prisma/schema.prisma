generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Setor {
  id                         Int              @id @default(autoincrement())
  nome                       String
  sigla                      String           @unique
  tipo                       TipoSetor        @default(SECRETARIA)
  responsavel                String?
  descricao                  String?
  idSetor                    Int?
  criadoEm                   DateTime         @default(now())
  atualizadoEm               DateTime         @updatedAt
  setorPai                   Setor?           @relation("SetorHierarquia", fields: [idSetor], references: [id])
  subSetores                 Setor[]          @relation("SetorHierarquia")
  licitacoes                 LicitacaoSetor[]
  pedidosSolicitados         Pedido[]         @relation("SolicitantePedido")
  termosRenovacaoSolicitados TermoRenovacao[] @relation("SolicitanteTermo")
  usuarios                   Usuario[]

  @@map("setor")
}

model Usuario {
  id               Int               @id @default(autoincrement())
  idSetor          Int
  nome             String
  email            String            @unique
  senha            String
  funcao           FuncaoUsuario
  isAdmin          Boolean           @default(false)
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt
  avaliacoesFeitas Avaliacao[]
  pedidosCriados   Pedido[]
  historicoPedidos PedidoHistorico[]
  termosEmitidos   TermoRenovacao[]  @relation("TermoEmissor")
  termosResolvidos TermoRenovacao[]  @relation("TermoResolvido")
  setor            Setor             @relation(fields: [idSetor], references: [id])
  solicitacoes     Solicitacao[]

  @@index([idSetor])
  @@map("usuario")
}

model LicitacaoContrato {
  id                  Int              @id @default(autoincrement())
  numero              String           @unique
  numeroProcesso      String
  modalidade          String
  objeto              String
  fornecedor          String
  cnpjFornecedor      String
  dataAbertura        DateTime
  dataVigenciaFim     DateTime
  status              StatusContrato   @default(RASCUNHO)
  valorTotal          Float
  arquivoContrato     String?
  dataGeracaoContrato DateTime?
  dispensa            String?
  numContrato         String?
  numProcesso         String?
  statusBool          Boolean?
  avaliacoes          Avaliacao[]
  itens               ItemLicitado[]
  setores             LicitacaoSetor[]
  notasFiscais        NotaFiscal[]
  pedidos             Pedido[]
  termosRenovacao     TermoRenovacao[]
  contratantes        Contratante[]
  contratados         Contratado[]

  @@map("licitacao")
}

model ItemLicitado {
  id                  Int                   @id @default(autoincrement())
  idLicitacao         Int
  descricao           String
  discriminacao       String?
  marca               String
  unidade             String
  quantidade          Int
  precoUnitario       Float
  precoTotal          Float
  recebido            Int                   @default(0)
  consumido           Int                   @default(0)
  idLicitacaoContrato Int?
  licitacao           LicitacaoContrato     @relation(fields: [idLicitacao], references: [id])
  movimentacoes       MovimentacaoEstoque[]
  notaFiscalItems     NotaFiscalItem[]
  pedidoItems         PedidoItem[]
  solicitacoes        Solicitacao[]

  @@index([idLicitacao])
  @@map("item_licitado")
}

model LicitacaoSetor {
  id          Int               @id @default(autoincrement())
  idLicitacao Int
  idSetor     Int
  licitacao   LicitacaoContrato @relation(fields: [idLicitacao], references: [id])
  setor       Setor             @relation(fields: [idSetor], references: [id])

  @@unique([idLicitacao, idSetor])
  @@index([idSetor])
  @@map("licitacao_setor")
}

model Pedido {
  id                  Int                   @id @default(autoincrement())
  idUsuarioCriador    Int
  idSetorCriador      Int
  idContrato          Int
  numeroPedido        String                @unique
  dataPedido          DateTime              @default(now())
  dataPrevistaEntrega DateTime?
  status              StatusPedido          @default(PENDENTE)
  numeroOrdem         String?
  dataOrdem           DateTime?
  observacao          String?
  arquivoTermo        String?
  dataGeracaoTermo    DateTime?
  avaliacoes          Avaliacao[]
  movimentacoes       MovimentacaoEstoque[]
  notasFiscais        NotaFiscal[]
  contrato            LicitacaoContrato     @relation(fields: [idContrato], references: [id])
  setor               Setor                 @relation("SolicitantePedido", fields: [idSetorCriador], references: [id])
  usuario             Usuario               @relation(fields: [idUsuarioCriador], references: [id])
  historico           PedidoHistorico[]
  itens               PedidoItem[]

  @@index([idSetorCriador])
  @@index([idContrato])
  @@map("pedido")
}

model PedidoHistorico {
  id        Int                 @id @default(autoincrement())
  idPedido  Int
  tipo      TipoHistoricoPedido
  status    StatusPedido?
  mensagem  String?
  idUsuario Int
  data      DateTime            @default(now())
  pedido    Pedido              @relation(fields: [idPedido], references: [id])
  usuario   Usuario             @relation(fields: [idUsuario], references: [id])

  @@index([idPedido])
  @@map("pedido_historico")
}

model PedidoItem {
  id             Int          @id @default(autoincrement())
  idPedido       Int
  idItemLicitado Int
  quantidade     Int
  valorUnitario  Float
  valorTotal     Float
  itemLicitado   ItemLicitado @relation(fields: [idItemLicitado], references: [id])
  pedido         Pedido       @relation(fields: [idPedido], references: [id])

  @@index([idPedido])
  @@index([idItemLicitado])
  @@map("pedido_item")
}

model NotaFiscal {
  id            Int                   @id @default(autoincrement())
  idPedido      Int
  idContrato    Int
  numeroNota    String
  dataEmissao   DateTime
  dataEntrada   DateTime              @default(now())
  observacao    String?
  movimentacoes MovimentacaoEstoque[]
  contrato      LicitacaoContrato     @relation(fields: [idContrato], references: [id])
  pedido        Pedido                @relation(fields: [idPedido], references: [id])
  itens         NotaFiscalItem[]

  @@index([idPedido])
  @@map("nota_fiscal")
}

model NotaFiscalItem {
  id             Int          @id @default(autoincrement())
  idNotaFiscal   Int
  idItemLicitado Int
  quantidade     Int
  valorUnitario  Float
  // Conferência do fiscal de contratos no ato do recebimento
  marcaConferida Boolean      @default(false)
  itemLicitado   ItemLicitado @relation(fields: [idItemLicitado], references: [id])
  notaFiscal     NotaFiscal   @relation(fields: [idNotaFiscal], references: [id])

  @@index([idNotaFiscal])
  @@index([idItemLicitado])
  @@map("nota_fiscal_item")
}

model MovimentacaoEstoque {
  id             Int              @id @default(autoincrement())
  tipo           TipoMovimentacao
  idItemLicitado Int
  quantidade     Int
  idNotaFiscal   Int?
  idPedido       Int?
  data           DateTime         @default(now())
  observacao     String?
  itemLicitado   ItemLicitado     @relation(fields: [idItemLicitado], references: [id])
  notaFiscal     NotaFiscal?      @relation(fields: [idNotaFiscal], references: [id])
  pedido         Pedido?          @relation(fields: [idPedido], references: [id])

  @@index([idItemLicitado])
  @@index([idNotaFiscal])
  @@map("movimentacao_estoque")
}

model Avaliacao {
  id                Int               @id @default(autoincrement())
  idPedido          Int
  idContrato        Int
  idUsuarioFiscal   Int
  dataAvaliacao     DateTime          @default(now())
  notaEntrega       Int
  notaPrazo         Int
  possuiProblema    Boolean           @default(false)
  descricaoProblema String?
  observacao        String?
  contrato          LicitacaoContrato @relation(fields: [idContrato], references: [id])
  pedido            Pedido            @relation(fields: [idPedido], references: [id])
  usuarioFiscal     Usuario           @relation(fields: [idUsuarioFiscal], references: [id])

  @@index([idContrato])
  @@index([idPedido])
  @@map("avaliacao")
}

model TermoRenovacao {
  id                  Int                  @id @default(autoincrement())
  idContrato          Int
  idUsuarioEmissor    Int
  idSetorSolicitante  Int?
  tipo                TipoRenovacao
  status              StatusTermoRenovacao @default(EMITIDO)
  justificativa       String
  novaVigenciaFim     DateTime?
  percentualAcrescimo Float?
  parecerLicitacao    String?
  acaoTomada          AcaoTomada?
  idUsuarioLicitacao  Int?
  dataEmissao         DateTime             @default(now())
  dataResolucao       DateTime?
  contrato            LicitacaoContrato    @relation(fields: [idContrato], references: [id])
  setorSolicitante    Setor?               @relation("SolicitanteTermo", fields: [idSetorSolicitante], references: [id])
  usuarioEmissor      Usuario              @relation("TermoEmissor", fields: [idUsuarioEmissor], references: [id])
  usuarioLicitacao    Usuario?             @relation("TermoResolvido", fields: [idUsuarioLicitacao], references: [id])

  @@index([idContrato])
  @@index([status])
  @@map("termo_renovacao")
}

model pdf_data {
  id                 Int       @id @default(autoincrement())
  original_name      String
  mime_type          String
  file_size          Int
  raw_text           String
  structured_data    Json
  extraction_summary String?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
}

model Contratante {
  id                  Int                @id @default(autoincrement())
  endereco            String?
  CNPJ                String?
  nomePrefeito        String?
  cpfPrefeito         Int?
  carteiraIdentidade  String?
  idLicitacaoContrato Int?
  licitacaoContrato   LicitacaoContrato? @relation(fields: [idLicitacaoContrato], references: [id])

  @@map("contratante")
}

model Contratado {
  id                  Int                @id @default(autoincrement())
  nome                String?
  endereco            String?
  CNPJ                String?
  idLicitacaoContrato Int?
  licitacaoContrato   LicitacaoContrato? @relation(fields: [idLicitacaoContrato], references: [id])

  @@map("contratado")
}

model Solicitacao {
  id              Int           @id @default(autoincrement())
  idUsuario       Int
  idItemLicitado  Int
  dataSolicitacao DateTime      @default(now())
  quantPedida     Int
  usuario         Usuario       @relation(fields: [idUsuario], references: [id])
  itemLicitado    ItemLicitado  @relation(fields: [idItemLicitado], references: [id])

  @@map("solicitacao")
}

enum FuncaoUsuario {
  PREFEITO
  SECRETARIO
  SERVIDOR
  FISCAL
}

// Natureza do setor: unidade de governo (secretaria), setor administrativo
// (licitações, compras, fiscalização) ou o gabinete do prefeito.
enum TipoSetor {
  GABINETE
  SETOR
  SECRETARIA
}

enum StatusContrato {
  RASCUNHO
  ATIVA
  EM_ADITAMENTO
  ENCERRADA
  VENCIDA
}

enum StatusPedido {
  PENDENTE
  CONFIRMADO
  EFETUADO
  ENTREGUE
  CONCLUIDO
  DEVOLVIDO
  CANCELADO
}

enum TipoHistoricoPedido {
  CRIACAO
  STATUS
  AVISO
}

enum TipoRenovacao {
  VIGENCIA
  QUANTITATIVO
  FINANCEIRO
}

enum StatusTermoRenovacao {
  EMITIDO
  EM_ANALISE
  RESOLVIDO
  ARQUIVADO
}

enum AcaoTomada {
  ADITIVO_VIGENCIA
  ADITIVO_QUANTITATIVO
  ADITIVO_FINANCEIRO
  NOVA_LICITACAO
  DENEGADO
}

enum TipoMovimentacao {
  ENTRADA
  BAIXA
}
