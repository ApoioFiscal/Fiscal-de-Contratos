# Backend — Fiscal de Contratos (api apoiofiscal)
#
# Copie este arquivo para `.env` e preencha com os valores corretos.
# O `.env` NÃO deve ser versionado.

# Conexão com o PostgreSQL.
# ATENÇÃO: o backend e o modulo de parsing compartilham o mesmo banco "prefeitura".
DATABASE_URL=postgresql://usuario:senha@localhost:5432/prefeitura

# Chave secreta usada para assinar os tokens JWT.
# Gere uma aleatória com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-aleatorio

PORT=3333
NODE_ENV=development